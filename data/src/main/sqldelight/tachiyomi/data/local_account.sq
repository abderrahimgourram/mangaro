-- Personal-state archive, in the SAME SQLite database as the stable catalog IDs.
-- Original tables are the active workspace projection. Switching is one transaction.
CREATE TABLE local_account_context (
    id INTEGER NOT NULL PRIMARY KEY CHECK(id = 1),
    owner TEXT NOT NULL,
    transitioning INTEGER NOT NULL DEFAULT 0,
    guest_generation INTEGER NOT NULL DEFAULT 0
);
INSERT INTO local_account_context(id, owner) VALUES(1, 'guest');
CREATE TABLE local_account_snapshots (
    owner TEXT NOT NULL,
    table_name TEXT NOT NULL,
    row_key INTEGER NOT NULL,
    payload TEXT NOT NULL,
    PRIMARY KEY(owner, table_name, row_key)
);
CREATE TABLE local_account_claims (
    owner TEXT NOT NULL,
    guest_generation INTEGER NOT NULL,
    claimed_at INTEGER NOT NULL,
    PRIMARY KEY(owner, guest_generation)
);

CREATE TABLE local_account_file_claims (
    guest_generation INTEGER NOT NULL PRIMARY KEY,
    owner TEXT NOT NULL
);
CREATE INDEX local_file_claims_owner ON local_account_file_claims(owner);
